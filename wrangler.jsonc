{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gxl-akilli-satici-api",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CRM_STORE", "class_name": "CrmStore" }] },
  "migrations": [{ "tag": "crm-sqlite-v1", "new_sqlite_classes": ["CrmStore"] }],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/30 * * * *"] },
  "kv_namespaces": [
    {
      "binding": "ETSY_OAUTH",
      "id": "a25ddefa50874df19970648274b891c7"
    }
  ]
}
